# 站点信息
VITE_SITE_NAME="你的站点名称" # 名称
VITE_SITE_ANTHOR="你的作者名" # 作者
VITE_SITE_KEYWORDS="关键词1,关键词2" # 关键词
VITE_SITE_DES="站点简介" # 站点简介
VITE_SITE_URL="example.com" # 站点地址
VITE_SITE_LOGO="/images/icon/favicon.jpg" # 站点主图标
VITE_SITE_MAIN_LOGO="/images/icon/logo.jpg" # 主页图标
VITE_SITE_APPLE_LOGO="/images/logo/logo.png" # Apple 端图标

# 简介文本
VITE_DESC_HELLO="Hello World !"
VITE_DESC_TEXT="一个建立于 21 世纪的小站，存活于互联网的边缘"
VITE_DESC_HELLO_OTHER="Oops !"
VITE_DESC_TEXT_OTHER="哎呀，这都被你发现了（ 再点击一次可关闭 ）"

# 社交链接
## 请在 src/assets/socialLinks.json 文件中配置

# 网站链接
## 请在 src/assets/siteLinks.json 文件中配置
## 网站链接的图标名称可前往 https://www.xicons.org 自行挑选并在 src/components/Links/index.vue 中引入

# 天气平台选择
## 可选值：amap: 高德 | open-meteo: Open-Meteo | qweather: 和风天气 | 留空-教书先生
## 高德控制台：https://console.amap.com/dev/key/app （Web服务 Key，免费，每日上限 5000 次）
## Open-Meteo：https://open-meteo.com/en/docs （免费开源，无需 Key）
## 和风天气控制台：https://console.qweather.com/ （免费申请 Key，每日有免费额度）
## 教书先生：https://api.oioweb.cn/doc/weather/GetWeather （无需 Key）
VITE_WEATHER_PROVIDER=amap

# 天气 Key（按所选平台填入对应 Key，Open-Meteo/教书先生 无需 Key 可留空）
VITE_WEATHER_KEY=""

# 和风天气 API Host（仅 qweather 平台需要）
## 和风天气已弃用公共域名，需在控制台「设置」页查看个人专属 API Host
## 控制台：https://console.qweather.com/ → 设置 → API Host
## 形如：h2a9cf3mhs.xy.qweatherapi.com（不含 https:// 前缀）
## 留空则回退使用公共域名 geoapi.qweather.com / devapi.qweather.com
VITE_WEATHER_QWEATHER_API=""

# 天气缓存时间（分），0 表示不使用缓存
VITE_WEATHER_CACHE_TIME=10

# 建站日期
## 若不需要，请设为空即可
## 请按照 YYYY-MM-DD 格式填写或者仅填写年份 YYYY
VITE_SITE_START="2026"

# ICP 备案号
## 若不需要，请设为空即可
VITE_SITE_ICP=""

# 萌 ICP 备案号 只要id就行 纯数字
VITE_SITE_ICP_MENG=""

# 歌曲 API 地址
## 请参照 https://github.com/xizeyoupan/Meting-API#deno-deploy 进行 API 服务部署
## 此处提供的服务可能会超量从而无法访问，请自行部署
## 若使用 QQ 音乐歌单，歌曲数量最好不要超出 50 首
## 备用：https://api.wuenci.com/meting/api/
VITE_SONG_API="https://music-home.yalis.cn/api"
# 歌曲服务器 ( netease-网易云, tencent-qq音乐 )
VITE_SONG_SERVER="netease"
# 播放类型 ( song-歌曲, playlist-播放列表, album-专辑, search-搜索, artist-艺术家 )
VITE_SONG_TYPE="playlist"
# 播放 ID ( 若无需播放器，请设为空即可 )
VITE_SONG_ID=""